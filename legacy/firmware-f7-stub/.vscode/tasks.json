{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure",
      "type": "shell",
      "command": "cmake -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE=cmake/arm-none-eabi-toolchain.cmake",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake --build build",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "group": "build"
    }
  ]
}