(version 1)

# Hole-to-copper clearance is 0.25 mm everywhere (the board-setup minimum is set to 0.19 mm
# only so that the exception below is possible).
(rule "hole clearance"
  (constraint hole_clearance (min 0.25)))

# The GCT USB4105 land pattern (KiCad stock footprint, as the manufacturer draws it) puts the
# A1/B12 and A12/B1 ground pads 0.19 mm from the connector's two non-plated locating holes.
# Allowed for this footprint only; confirm the fab accepts 0.19 mm NPTH-to-copper.
(rule "USB-C locating pegs"
  (condition "A.memberOfFootprint('J12') && B.memberOfFootprint('J12')")
  (constraint hole_clearance (min 0.19)))
